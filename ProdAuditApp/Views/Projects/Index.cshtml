@using ProdAuditApp.Data.Model.Domain
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model Projects
@{
    ViewData["Title"] = ViewData["MasterCode"];
    Layout = "_ContentNavbarLayout";
    var masterCode = ViewData["MasterCode"] as string ?? @HttpContextAccessor.HttpContext.Request.Query["masterCode"].ToString();
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert" class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <script>
        setTimeout(function () {
            const alertNode = document.getElementById('successAlert');
            if (alertNode) {
                const alert = bootstrap.Alert.getOrCreateInstance(alertNode);
                alert.close();
            }
        }, 5000); // 15 seconds
    </script>
}

@{
    TempData.Remove("SuccessMessage");
}

@* ************** Content ************** *@
<!-- Basic Bootstrap Table -->
<div class="card">
    <div class="col-xxl">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Projects</h5>
                <a class="text-body-secondary float-end" href="@Url.Action("Index", "Master", new { masterCode = "Projects" })">Back to Search</a>
            </div>
            <div class="card-body">
                <form asp-action="Save" asp-controller="Projects" method="post">
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtProjectCode">Project Code</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="projectCode" class="form-control" id="txtProjectCode" placeholder="Project Code" />
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtProjectName">Project Name</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="projectName" class="form-control" id="txtProjectName" placeholder="Project Name" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtClient">Client</label>
                        <div class="col-sm-4">
                            <select asp-for="clientId"
                                    asp-items="ViewBag.ClientList"
                                    class="form-control">
                                <option value="">-- Select Client --</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtProductionHouse">Production House</label>
                        <div class="col-sm-4">
                            <select asp-for="phId"
                                    asp-items="ViewBag.ProductionHouseList"
                                    class="form-control">
                                <option value="">-- Select Production House --</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtProjectType">Project Type</label>
                        <div class="col-sm-4">
                            <select asp-for="projectType"
                                    asp-items="ViewBag.ProjectTypeList"
                                    class="form-control">
                                <option value="">-- Select Project Type --</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtStartDate">Start Date</label>
                        <div class="col-sm-4">
                            <input type="date" asp-for="startDate" class="form-control" id="txtStartDate" />
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtTentativeEndDate">Tentative End Date</label>
                        <div class="col-sm-4">
                            <input type="date" asp-for="tentendDate" class="form-control" id="txtTentativeEndDate" />
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtEndDate">End Date</label>
                        <div class="col-sm-4">
                            <input type="date" asp-for="endDate" class="form-control" id="txtEndDate" />
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-sm-4">
                            <input type="hidden" asp-for="projectId" id="hdnProjectId" />
                        </div>
                    </div>
                    <div class="row justify-content-end">
                        <div class="col-sm-10">
                            <button id="btnSave" type="submit" class="btn btn-primary">Save</button>
                            <button id="btnCancel" asp-action="Index" class="btn btn-primary">Cancel</button>
                            @if (Model?.projectId > 0)
                            {
                                <button type="submit"
                                        formaction="@Url.Action("Delete", "Projects")"
                                        formmethod="post"
                                        class="btn btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this Production House?');">
                                    Delete
                                </button>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

