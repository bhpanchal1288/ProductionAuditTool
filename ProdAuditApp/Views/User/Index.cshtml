@using ProdAuditApp.Data.Model.Domain
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model User
@{
    ViewData["Title"] = ViewData["MasterCode"];
    Layout = "_ContentNavbarLayout";
    var masterCode = ViewData["MasterCode"] as string ?? @HttpContextAccessor.HttpContext.Request.Query["masterCode"].ToString();
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert" class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <script>
        setTimeout(function () {
            const alertNode = document.getElementById('successAlert');
            if (alertNode) {
                const alert = bootstrap.Alert.getOrCreateInstance(alertNode);
                alert.close();
            }
        }, 5000); // 15 seconds
    </script>
}

@{
    TempData.Remove("SuccessMessage");
}

@* ************** Content ************** *@
<!-- Basic Bootstrap Table -->
<div class="card">
    <div class="col-xxl">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">User</h5>
                <a class="text-body-secondary float-end" href="@Url.Action("Index", "Master", new { masterCode = "User" })">Back to Search</a>
            </div>
            <div class="card-body">
                <form asp-action="Save" asp-controller="User" method="post">
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="cmbGroup">User Group</label>
                        <div class="col-sm-4">
                            <select asp-for="groupid"
                                    asp-items="ViewBag.GroupList"
                                    class="form-control">
                                <option value="">-- Select User Group --</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtFirstName">First Name</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="firstname" class="form-control" id="txtFirstName" placeholder="First Name" />
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtLastName">Last Name</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="lastname" class="form-control" id="txtLastName" placeholder="Last Name" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtMobile">Mobile</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="mobile" class="form-control" id="txtMobile" placeholder="Mobile" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtEmailId">Email ID</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="emailid" class="form-control" id="txtEmailId" placeholder="Email ID" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtPassword">Password</label>
                        <div class="col-sm-4">
                            <input type="password" asp-for="password" class="form-control" id="txtPassword" placeholder="Password" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-sm-4">
                            <input type="hidden" asp-for="userid" id="hdnUserId" />
                        </div>
                    </div>
                    <div class="row justify-content-end">
                        <div class="col-sm-10">
                            <button id="btnSave" type="submit" class="btn btn-primary">Save</button>
                            <button id="btnCancel" asp-action="Index" class="btn btn-primary">Cancel</button>
                            @if (Model?.userid > 0)
                            {
                                <button type="submit"
                                        formaction="@Url.Action("Delete", "User")"
                                        formmethod="post"
                                        class="btn btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this user?');">
                                    Delete
                                </button>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

