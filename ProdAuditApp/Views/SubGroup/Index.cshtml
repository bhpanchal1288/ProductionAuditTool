@using ProdAuditApp.Data.Model.Domain
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model SubGroup
@{
    ViewData["Title"] = ViewData["MasterCode"];
    Layout = "_ContentNavbarLayout";
    var masterCode = ViewData["MasterCode"] as string ?? @HttpContextAccessor.HttpContext.Request.Query["masterCode"].ToString();
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert" class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <script>
        setTimeout(function () {
            const alertNode = document.getElementById('successAlert');
            if (alertNode) {
                const alert = bootstrap.Alert.getOrCreateInstance(alertNode);
                alert.close();
            }
        }, 5000); // 15 seconds
    </script>
}

@{
    TempData.Remove("SuccessMessage");
}

@* ************** Content ************** *@
<!-- Basic Bootstrap Table -->
<div class="card">
    <div class="col-xxl">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Sub Group</h5>
                <a class="text-body-secondary float-end" href="@Url.Action("Index", "Master", new { masterCode = "Sub Group" })">Back to Search</a>
            </div>
            <div class="card-body">
                <form asp-action="Save" asp-controller="SubGroup" method="post">
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="cmbGroup">Group</label>
                        <div class="col-sm-4">
                            <select asp-for="groupid"
                                    asp-items="ViewBag.GroupList"
                                    class="form-control">
                                <option value="">-- Select Group --</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtSubGroupCode">Sub Group Code</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="subgroupcode" class="form-control" id="txtSubGroupCode" placeholder="Sub Group Code" />
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtSubGroupName">Sub Group Name</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="subgroupname" class="form-control" id="txtSubGroupName" placeholder="Sub Group Name" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="cmbCategory">Category</label>
                        <div class="col-sm-4">
                            <select asp-for="categoryid"
                                    asp-items="ViewBag.CategoryList"
                                    class="form-control">
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtSubGroupDesc">Description</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="subgroupdesc" class="form-control" id="txtSubGroupDesc" placeholder="Sub Group Name" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-sm-4">
                            <input type="hidden" asp-for="subgroupid" id="hdnSubGroupId" />
                        </div>
                    </div>
                    <div class="row justify-content-end">
                        <div class="col-sm-10">
                            <button id="btnSave" type="submit" class="btn btn-primary">Save</button>
                            <button id="btnCancel" asp-action="Index" class="btn btn-primary">Cancel</button>
                            @if (Model?.subgroupid > 0)
                            {
                                <button type="submit"
                                        formaction="@Url.Action("Delete", "SubGroup")"
                                        formmethod="post"
                                        class="btn btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this Sub Group?');">
                                    Delete
                                </button>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

