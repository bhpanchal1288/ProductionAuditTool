@using ProdAuditApp.Data.Model.Domain
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model Contracts
@{
    ViewData["Title"] = ViewData["MasterCode"];
    Layout = "_ContentNavbarLayout";
    var masterCode = ViewData["MasterCode"] as string ?? @HttpContextAccessor.HttpContext.Request.Query["masterCode"].ToString();
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert" class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <script>
        setTimeout(function () {
            const alertNode = document.getElementById('successAlert');
            if (alertNode) {
                const alert = bootstrap.Alert.getOrCreateInstance(alertNode);
                alert.close();
            }
        }, 5000); // 15 seconds
    </script>
}

@{
    TempData.Remove("SuccessMessage");
}

@* ************** Content ************** *@
<!-- Basic Bootstrap Table -->
<div class="card">
    <div class="col-xxl">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">
                    Contracts @* @(string.IsNullOrWhiteSpace(ViewBag.ProjectName as string) ? "" : $" - {ViewBag.ProjectName}") *@
                </h5>
                <a class="text-body-secondary float-end" href="@Url.Action("Index", "Master", new { masterCode = "Contracts" })">Back to Search</a>
            </div>
            <div class="card-body">
                <form asp-action="Save" asp-controller="Contracts" method="post">
                    
                    
                    <div class="row mb-4">
                        <label class="col-sm-8 col-form-label" for="cmbProject">Project</label>
                        <label class="col-sm-2 col-form-label" for="txtContractNo">Contract No</label>
                        <label class="col-sm-2 col-form-label" for="txtContractDate">Contract Date</label>                        
                    </div>
                    <div class="row mb-4">
                        <div class="col-sm-8">
                            <select asp-for="projectid"
                                    asp-items="ViewBag.ProjectList"
                                    class="form-control"
                                    id="cmbProject">
                                <option value="">-- Select Project --</option>
                            </select>
                        </div>
                        <div class="col-sm-2">
                            <input type="text" asp-for="contractno" class="form-control" id="txtContractNo" placeholder="Contract No" />
                        </div>
                        <div class="col-sm-2">
                            <input type="date" asp-for="contractdate" class="form-control" id="txtContractDate" placeholder="Contract Date" />
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-8 col-form-label" for="cmbVendor">Vendor</label>
                        <label class="col-sm-2 col-form-label" for="txtWorkStartDate">Work Start Date</label>
                        <label class="col-sm-2 col-form-label" for="txtWorkEndDate">Work End Date</label>
                        
                    </div>
                    <div class="row mb-4">
                        <div class="col-sm-8">
                            <select asp-for="vendorid"
                                    asp-items="ViewBag.VendorList"
                                    class="form-control"
                                    id="cmbVendor">
                                <option value="">-- Select Vendor --</option>
                            </select>
                        </div>
                        <div class="col-sm-2">
                            <input type="date" asp-for="workstartdate" class="form-control" id="txtWorkStartDate" placeholder="Work Start Date" />
                        </div>
                        <div class="col-sm-2">
                            <input type="date" asp-for="workenddate" class="form-control" id="txtWorkEndDate" placeholder="Work End Date" />
                        </div>
                    </div>

                    <!-- Detail editor: add rows dynamically -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body p-2">
                                    <div class="d-flex justify-content-between mb-2">
                                        <h6 class="mb-0">Contract Details</h6>
                                        <button type="button" id="btnAddDetailRow" class="btn btn-sm btn-success">Add</button>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered" id="detailEditorTable">
                                            <thead>
                                                <tr>
                                                    <th>Group</th>
                                                    <th>Category</th>
                                                    <th>Subgroup</th>
                                                    <th>Rate</th>
                                                    <th>UOM</th>
                                                    <th>Quantity</th>
                                                    <th>Amount</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @* Render existing details if present *@
                                                @if (Model?.Details != null && Model.Details.Count > 0)
                                                {
                                                    for (int i = 0; i < Model.Details.Count; i++)
                                                    {
                                                        var d = Model.Details[i];
                                                        <tr>
                                                            <td>
                                                                <select name="Details[@i].groupid" class="form-select form-select-sm">
                                                                    <option value="">-- Select --</option>
                                                                    @foreach (SelectListItem it in (IEnumerable<SelectListItem>)ViewBag.GroupList ?? new List<SelectListItem>())
                                                                    {
                                                                        <option value="@it.Value" selected=@(it.Value == d.groupid.ToString())>@it.Text</option>
                                                                    }
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <select name="Details[@i].categoryid" class="form-select form-select-sm">
                                                                    <option value="">-- Select --</option>
                                                                    @foreach (SelectListItem it in (IEnumerable<SelectListItem>)ViewBag.CategoryList ?? new List<SelectListItem>())
                                                                    {
                                                                        <option value="@it.Value" selected=@(it.Value == d.categoryid.ToString())>@it.Text</option>
                                                                    }
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <select name="Details[@i].subgroupid" class="form-select form-select-sm">
                                                                    <option value="">-- Select --</option>
                                                                    @if (!string.IsNullOrEmpty(d.subgroupname))
                                                                    {
                                                                        <option value="@d.subgroupid" selected>@d.subgroupname</option>
                                                                    }
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <input type="number" step="0.01" name="Details[@i].rate" class="form-control form-control-sm rate-input" value="@d.rate" />
                                                            </td>
                                                            <td>
                                                                <select name="Details[@i].uom" class="form-select form-select-sm">
                                                                    <option value="">-- Select --</option>
                                                                    @foreach (SelectListItem it in (IEnumerable<SelectListItem>)ViewBag.UOMList ?? new List<SelectListItem>())
                                                                    {
                                                                        <option value="@it.Value" selected=@(it.Value == d.uomid.ToString())>@it.Text</option>
                                                                    }
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <input type="number" step="0.01" name="Details[@i].quantity" class="form-control form-control-sm qty-input" value="@d.quantity" />
                                                            </td>
                                                            <td>
                                                                <input type="number" step="0.01" name="Details[@i].amount" class="form-control form-control-sm amount-input" value="@d.amount" onchange="updateNetAmount();" />
                                                            </td>
                                                            <td>
                                                                <button type="button" class="btn btn-sm btn-danger" onclick="removeDetailRow(this)">Remove</button>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr id="noDetailRow"><td colspan="8" class="text-center text-body-secondary">No details added.</td></tr>
                                                }

                                                <!-- template row (hidden) -->
                                                <tr id="detailTemplate" class="d-none">
                                                    <td>
                                                        <select name="Details[__INDEX__].groupid" class="form-select form-select-sm">
                                                            <option value="">-- Select --</option>
                                                            @foreach (SelectListItem it in (IEnumerable<SelectListItem>)ViewBag.GroupList ?? new List<SelectListItem>())
                                                            {
                                                                <option value="@it.Value">@it.Text</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select name="Details[__INDEX__].categoryid" class="form-select form-select-sm">
                                                            <option value="">-- Select --</option>
                                                            @foreach (SelectListItem it in (IEnumerable<SelectListItem>)ViewBag.CategoryList ?? new List<SelectListItem>())
                                                            {
                                                                <option value="@it.Value">@it.Text</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select name="Details[__INDEX__].subgroupid" class="form-select form-select-sm">
                                                            <option value="">-- Select --</option>
                                                        </select>
                                                    </td>
                                                    <td><input type="number" step="0.01" name="Details[__INDEX__].rate" class="form-control form-control-sm rate-input" /></td>
                                                    <td>
                                                        <select name="Details[__INDEX__].uom" class="form-select form-select-sm">
                                                            <option value="">-- Select --</option>
                                                            @foreach (SelectListItem it in (IEnumerable<SelectListItem>)ViewBag.UOMList ?? new List<SelectListItem>())
                                                            {
                                                                <option value="@it.Value">@it.Text</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td><input type="number" step="0.01" name="Details[__INDEX__].quantity" class="form-control form-control-sm qty-input" /></td>
                                                    <td><input type="number" step="0.01" name="Details[__INDEX__].amount" class="form-control form-control-sm amount-input" onchange="updateNetAmount();" /></td>
                                                    <td><button type="button" class="btn btn-sm btn-danger" onclick="removeDetailRow(this)">Remove</button></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtNetAmount">Net Amount</label>
                        <div class="col-sm-4">
                            <input type="number" asp-for="netamount" class="form-control" id="txtNetAmount" placeholder="Net Amount" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtTax">Tax</label>
                        <div class="col-sm-4">
                            <input type="number" asp-for="tax" class="form-control" id="txtTax" placeholder="Tax" onkeyup="UpdateGrossAmount()" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtGrossAmount">Gross Amount</label>
                        <div class="col-sm-4">
                            <input type="number" asp-for="grossamount" class="form-control" id="txtGrossAmount" placeholder="Gross Amount" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtDescription">Description</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="description" class="form-control" id="txtDescription" placeholder="Description" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-sm-4">
                            <input type="hidden" asp-for="contractid" id="hdnContractId" />
                            @* <input type="hidden" asp-for="projectid" id="hdnProjectId" /> *@
                        </div>
                    </div>
                    <div class="row justify-content-end">
                        <div class="col-sm-10">
                            <button id="btnSave" type="submit" class="btn btn-primary">Save</button>
                            <button id="btnCancel" asp-action="Index" asp-route-Id="@Model.contractid" class="btn btn-primary">Cancel</button>
                            @* @if (Model?.mappingid > 0)
                            {
                                <button type="submit"
                                        formaction="@Url.Action("Delete", "Mapping")"
                                        formmethod="post"
                                        class="btn btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this Mapping?');">
                                    Delete
                                </button>
                            } *@
                        </div>
                    </div>
                </form>
            </div>
        </div>
        
    </div>

    <script>
            async function loadSubGroups() {
                const groupSelect = document.getElementById('cmbGroup');
                const categorySelect = document.getElementById('cmbCategory');
                const subGroupSelect = document.getElementById('cmbSubGroup');
                if (!groupSelect || !categorySelect || !subGroupSelect) return;

                const groupId = groupSelect.value || 0;
                const categoryId = categorySelect.value || 0;

                // Preserve current selection when reloading options (edit scenarios)
                const previousSubGroupId = subGroupSelect.value;

                // Reset options
                subGroupSelect.innerHTML = '<option value="">-- Select Sub Group --</option>';
                if (!groupId || groupId === '0' || !categoryId || categoryId === '0') return;

                const url = '@Url.Action("GetSubGroupDropdownData", "Mapping")'
                    + '?groupid=' + encodeURIComponent(groupId)
                    + '&categoryid=' + encodeURIComponent(categoryId);
                const response = await fetch(url, { method: 'GET' });
                if (!response.ok) return;

                const items = await response.json();
                for (const item of items) {
                    const opt = document.createElement('option');
                    opt.value = item.valueId;
                    opt.textContent = item.valueDec;
                    subGroupSelect.appendChild(opt);
                }

                // Restore prior value if it still exists
                if (previousSubGroupId) subGroupSelect.value = previousSubGroupId;
            }

            // document.addEventListener('DOMContentLoaded', () => {
            //     loadSubGroups();
            // });

            async function editMapping(mappingId, groupId, categoryId, subGroupId, particulars) {
                const groupSelect = document.getElementById('cmbGroup');
                const categorySelect = document.getElementById('cmbCategory');
                const subGroupSelect = document.getElementById('cmbSubGroup');
                const particularInput = document.getElementById('txtParticular');
                const mappingIdInput = document.getElementById('hdnMappingId');

                if (mappingIdInput) mappingIdInput.value = mappingId || '';
                if (groupSelect) groupSelect.value = groupId || '';
                if (categorySelect) categorySelect.value = categoryId || '';
                if (particularInput) particularInput.value = particulars || '';

                await loadSubGroups();
                if (subGroupSelect) subGroupSelect.value = subGroupId || '';

                // scroll to top form
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            function deleteMapping(mappingId) {
                if (!mappingId) return;
                const mappingIdInput = document.getElementById('hdnMappingId');
                if (mappingIdInput) mappingIdInput.value = mappingId;

                if (confirm('Are you sure you want to delete this Mapping?')) {
                    // submit the existing form with its delete action (if wired in controller)
                    const form = document.querySelector('form[asp-controller="Mapping"], form[action*="/Mapping"]') || document.querySelector('form');
                    if (form) {
                        form.action = '@Url.Action("Delete", "Mapping")';
                        form.method = 'post';
                        form.submit();
                    }
                }
            }

    // Detail editor: add/remove rows and dynamic subgroup loading
    document.getElementById('btnAddDetailRow')?.addEventListener('click', function () {
        const tbody = document.querySelector('#detailEditorTable tbody');
        const template = document.getElementById('detailTemplate');
        if (!tbody || !template) return;

        // remove 'no details' row
        const noRow = document.getElementById('noDetailRow'); if (noRow) noRow.remove();

        const idx = tbody.querySelectorAll('tr').length; // includes template if visible; template has id and d-none so fine
        const clone = template.cloneNode(true);
        clone.classList.remove('d-none');
        clone.removeAttribute('id');

        // update names: replace __INDEX__ with idx
        clone.querySelectorAll('[name]').forEach(el => {
            const name = el.getAttribute('name');
            if (!name) return;
            el.setAttribute('name', name.replace(/__INDEX__/g, idx));
        });

        // attach change listener for group/category to load subgroup
        clone.querySelectorAll('select').forEach(sel => sel.addEventListener('change', function (e) {
            const name = sel.getAttribute('name') || '';
            if (name.endsWith('.groupid') || name.endsWith('.categoryid')) {
                const row = sel.closest('tr');
                const groupSel = row.querySelector('select[name$=".groupid"]');
                const catSel = row.querySelector('select[name$=".categoryid"]');
                const subSel = row.querySelector('select[name$=".subgroupid"]');
                populateSubgroupSelect(subSel, groupSel?.value, catSel?.value, '');
            }
        }));

        // attach inputs change for amount calc and update net
        const qty = clone.querySelector('input[name$=".quantity"]');
        const rate = clone.querySelector('input[name$=".rate"]');
        const amt = clone.querySelector('input[name$=".amount"]');
        if (qty && rate && amt) {
            const calc = () => { const q = parseFloat(qty.value) || 0; const r = parseFloat(rate.value) || 0; amt.value = (q * r).toFixed(2); updateNetAmount(); };
            qty.addEventListener('input', calc);
            rate.addEventListener('input', calc);
            // when amount manually edited
            amt.addEventListener('input', updateNetAmount);
        }

        tbody.appendChild(clone);
        reindexDetailRows();
    });

    function removeDetailRow(btn) {
        const tr = btn.closest('tr'); if (!tr) return; tr.remove();
        reindexDetailRows();
        const tbody = document.querySelector('#detailEditorTable tbody');
        if (!tbody.querySelectorAll('tr').length) {
            const nr = document.createElement('tr'); nr.id = 'noDetailRow'; nr.innerHTML = '<td colspan="8" class="text-center text-body-secondary">No details added.</td>';
            tbody.appendChild(nr);
        }
    }

    function reindexDetailRows() {
        const rows = Array.from(document.querySelectorAll('#detailEditorTable tbody tr')).filter(r => !r.id || r.id !== 'detailTemplate');
        rows.forEach((r, i) => {
            r.querySelectorAll('[name]').forEach(el => {
                const name = el.getAttribute('name');
                if (!name) return;
                el.setAttribute('name', name.replace(/Details\[\d+\]/, `Details[${i}]`));
            });
        });
    }

    async function populateSubgroupSelect(subSel, groupId, categoryId, preserve) {
        if (!subSel) return;
        subSel.innerHTML = '<option value="">-- Select --</option>';
        if (!groupId && !categoryId) return;
                const url = '@Url.Action("GetSubGroupDropdownData", "Contracts")' + '?groupId=' + encodeURIComponent(groupId || '') + '&categoryId=' + encodeURIComponent(categoryId || '');
        try {
            const resp = await fetch(url);
            if (!resp.ok) return;
            const list = await resp.json();
            list.forEach(it => {
                const o = document.createElement('option'); o.value = it.valueId ?? it.valueId ?? it.valueId; o.text = it.valueDec ?? it.valueDec ?? it.val; subSel.appendChild(o);
            });
            if (preserve) subSel.value = preserve;
        } catch (e) { console.error(e); }
    }

    // calculate net amount as sum of amount inputs in the details table
    function updateNetAmount() {
        try {
            const tbody = document.querySelector('#detailEditorTable tbody');
            if (!tbody) return;

            const rows = Array.from(tbody.querySelectorAll('tr')).filter(r => r.id !== 'detailTemplate' && r.id !== 'noDetailRow');
            let total = 0;
            rows.forEach(r => {
                const inp = r.querySelector('input[name$=".amount"]');
                if (!inp) return;
                const v = parseFloat(inp.value);
                if (!isNaN(v)) total += v;
            });

            const netInput = document.getElementById('txtNetAmount');
            const grossInput = document.getElementById('txtGrossAmount');
            if (netInput) netInput.value = total.toFixed(2);
            if (grossInput) grossInput.value = total.toFixed(2);
        } catch (err) {
            console.error('updateNetAmount error', err);
        }
    }

    function UpdateGrossAmount(){
            const netInput = document.getElementById('txtNetAmount');
            const taxInput = document.getElementById('txtTax');
            const grossInput = document.getElementById('txtGrossAmount');
            let total = 0;
            // if (!isNaN(netInput) && !isNaN(taxInput))
            // {
                total = parseFloat(netInput.value) + parseFloat(taxInput.value);
            // }
            if (grossInput) grossInput.value = total.toFixed(2);
    }

    // initialize existing rows (if any) on page load
    document.addEventListener('DOMContentLoaded', function () {
        const tbody = document.querySelector('#detailEditorTable tbody');
        if (!tbody) return;

        // for each existing detail row (excluding template and noDetailRow)
        const rows = Array.from(tbody.querySelectorAll('tr')).filter(r => r.id !== 'detailTemplate' && r.id !== 'noDetailRow');
        rows.forEach((row, idx) => {
            // ensure names are indexed
            row.querySelectorAll('[name]').forEach(el => {
                const name = el.getAttribute('name');
                if (!name) return;
                el.setAttribute('name', name.replace(/__INDEX__/g, idx).replace(/Details\[\d+\]/, `Details[${idx}]`));
            });

            const groupSel = row.querySelector('select[name$=".groupid"]');
            const catSel = row.querySelector('select[name$=".categoryid"]');
            const subSel = row.querySelector('select[name$=".subgroupid"]');
            const qty = row.querySelector('input[name$=".quantity"]');
            const rate = row.querySelector('input[name$=".rate"]');
            const amt = row.querySelector('input[name$=".amount"]');

            // wire subgroup population
            [groupSel, catSel].forEach(sel => {
                if (!sel) return;
                sel.addEventListener('change', () => populateSubgroupSelect(subSel, groupSel?.value, catSel?.value, subSel?.value));
            });

            // wire amount calculation
            if (qty && rate && amt) {
                const calc = () => { const q = parseFloat(qty.value) || 0; const r = parseFloat(rate.value) || 0; amt.value = (q * r).toFixed(2); updateNetAmount(); };
                qty.addEventListener('input', calc);
                rate.addEventListener('input', calc);
                // if amount manually edited
                amt.addEventListener('input', updateNetAmount);
            }
        });

        // initial net amount calculation
        updateNetAmount();
    });
    </script>
</div>

