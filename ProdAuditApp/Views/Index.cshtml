@using ProdAuditApp.Data.Model.Domain
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model Vendor
@{
    ViewData["Title"] = ViewData["MasterCode"];
    Layout = "_ContentNavbarLayout";
    var masterCode = ViewData["MasterCode"] as string ?? @HttpContextAccessor.HttpContext.Request.Query["masterCode"].ToString();
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert" class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <script>
        setTimeout(function () {
            const alertNode = document.getElementById('successAlert');
            if (alertNode) {
                const alert = bootstrap.Alert.getOrCreateInstance(alertNode);
                alert.close();
            }
        }, 5000); // 15 seconds
    </script>
}

@{
    TempData.Remove("SuccessMessage");
}

@* ************** Content ************** *@
<!-- Basic Bootstrap Table -->
<div class="card">
    <div class="col-xxl">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Vendor</h5>
                <a class="text-body-secondary float-end" href="@Url.Action("Index", "Master", new { masterCode = "Vendor" })">Back to Search</a>
            </div>
            <div class="card-body">
                <form asp-action="Save" asp-controller="Vendor" method="post">
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtVendorCode">Vendor Code</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="vendorCode" class="form-control" id="txtVendorCode" placeholder="Vendor Code" />
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtVendorName">Vendor Name</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="vendorName" class="form-control" id="txtVendorName" placeholder="Vendor Name" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtContactPerson">Contact Person</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="contactPerson" class="form-control" id="txtContactPerson" placeholder="Contact Person" />
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtAddress">Address</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="address" class="form-control" id="txtAddress" placeholder="Address" />
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtContact1">Contact 1</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="contact1" class="form-control" id="txtContact1" placeholder="Contact 1" />
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtClientName">Contact 2</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="contact2" class="form-control" id="txtContact2" placeholder="Contact 2" />
                        </div>
                    </div>
                    <div class="row mb-4">
                        <label class="col-sm-2 col-form-label" for="txtEmailId">Email ID</label>
                        <div class="col-sm-4">
                            <input type="text" asp-for="emailId" class="form-control" id="txtEmailId" placeholder="Email ID" />
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-sm-4">
                            <input type="hidden" asp-for="vendorId" id="hdnVendorId" />
                        </div>
                    </div>
                    <div class="row justify-content-end">
                        <div class="col-sm-10">
                            <button id="btnSave" type="submit" class="btn btn-primary">Save</button>
                            <button id="btnCancel" asp-action="Index" class="btn btn-primary">Cancel</button>
                            @if (Model?.vendorId > 0)
                            {
                                <button type="submit"
                                        formaction="@Url.Action("Delete", "Vendor")"
                                        formmethod="post"
                                        class="btn btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this vendor?');">
                                    Delete
                                </button>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

